# =========================
# Spring Profile
# =========================
SPRING_PROFILES_ACTIVE=prod

# =========================
# Server Configuration
# =========================
SERVER_PORT=8080

# =========================
# Production Module Ports
# =========================
BLOG_MODULE_PORT=8081
EMAIL_MODULE_PORT=8082
TEXT_MODULE_PORT=8083
IMAGE_MODULE_PORT=8084
DOCUMENT_MODULE_PORT=8085

# =========================
# Database Configuration (External Server)
# =========================
SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host:3306/sharedprompts?useSSL=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# =========================
# Redis Configuration
# =========================
REDIS_HOST=redis
REDIS_PORT=6379

# =========================
# RabbitMQ Configuration
# =========================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=your_rabbitmq_username
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_MANAGEMENT_PORT=15672

# =========================
# JWT Configuration
# =========================
JWT_SECRET=your_jwt_secret_key_minimum_256_bits
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# =========================
# OAuth2 Configuration
# =========================
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
NAVER_CLIENT_ID=your_naver_client_id
NAVER_CLIENT_SECRET=your_naver_client_secret
KAKAO_CLIENT_ID=your_kakao_client_id
KAKAO_CLIENT_SECRET=your_kakao_client_secret
OAUTH2_FAILURE_REDIRECT_URL=https://your-frontend-url.com/auth/failure
OAUTH2_SALT=your_oauth2_salt
OAUTH2_REDIRECT_FRONT_URL=https://your-frontend-url.com

# =========================
# CORS Configuration
# =========================
CORS_ALLOWED_ORIGINS=https://your-frontend-url.com,http://localhost:3000

# =========================
# AI Configuration
# =========================
SPRING_AI_OPENAI_API_KEY=your_openai_api_key
SPRING_AI_OPENAI_MODEL=gpt-4o-mini
SPRING_AI_OPENAI_TEMPERATURE=0.7
GOOGLE_GEMINI_API_KEY=your_gemini_api_key
GOOGLE_GEMINI_MODEL=gemini-pro
GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com

# =========================
# Groq AI Configuration (Text Generation)
# =========================
AI_PROVIDER_GROQ_ENABLED=true
AI_PROVIDER_GROQ_SECRET_KEY=your_groq_api_key
AI_PROVIDER_GROQ_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER_GROQ_DEFAULT_MODEL=llama-3.3-70b-versatile
AI_PROVIDER_GROQ_TIMEOUT_SECONDS=30
AI_PROVIDER_GROQ_MAX_RETRIES=3
AI_PROVIDER_GROQ_INITIAL_RETRY_DELAY_MS=1000

# =========================
# Leonardo AI Configuration (Image Generation)
# =========================
AI_PROVIDER_LEONARDO_ENABLED=true
AI_PROVIDER_LEONARDO_SECRET_KEY=your_leonardo_api_key
AI_PROVIDER_LEONARDO_BASE_URL=https://cloud.leonardo.ai/api/rest/v1
# NOTE: The model ID must be a valid model ID supported by Leonardo API v1
# See: https://docs.leonardo.ai/docs/commonly-used-api-values for valid model IDs
# Default: 7b592283-e8a7-4c5a-9ba6-d18c31f258b9 (Lucid Origin model)
AI_PROVIDER_LEONARDO_DEFAULT_MODEL_ID=7b592283-e8a7-4c5a-9ba6-d18c31f258b9
AI_PROVIDER_LEONARDO_TIMEOUT_SECONDS=30
AI_PROVIDER_LEONARDO_MAX_RETRIES=3
AI_PROVIDER_LEONARDO_INITIAL_RETRY_DELAY_MS=1000
AI_PROVIDER_LEONARDO_MAX_POLLING_WAIT_SECONDS=60
AI_PROVIDER_LEONARDO_POLLING_INTERVAL_SECONDS=2

# =========================
# Payment Configuration (Optional)
# =========================
PAYMENT_ENABLED=true
PAYMENT_KAKAO_SECRET=your_kakao_payment_secret
PAYMENT_KAKAO_CID=TC0ONETIME
PAYMENT_KAKAO_APPROVAL_URL=https://your-api-url.com/api/payment/kakao/approval
PAYMENT_KAKAO_CANCEL_URL=https://your-api-url.com/api/payment/kakao/cancel
PAYMENT_KAKAO_FAIL_URL=https://your-api-url.com/api/payment/kakao/fail
PAYMENT_TOSS_API_KEY=your_toss_api_key
PAYMENT_TOSS_SECRET_KEY=your_toss_secret_key
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key

# =========================
# Other Configuration
# =========================
JPA_SHOW_SQL=false
JPA_DDL_AUTO=none
HIBERNATE_DIALECT=org.hibernate.dialect.MySQLDialect
HIBERNATE_BATCH_SIZE=50

