# =========================
# 서버 설정
# =========================
SERVER_PORT=8080

# =========================
# 데이터베이스 설정 (필수)
# =========================
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/sharedprompts?useSSL=false&serverTimezone=Asia/Seoul&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your_mysql_password_here

# =========================
# HikariCP 커넥션 풀 설정 (선택적 - 환경별 파일에서 기본값 제공)
# =========================
# 개발 환경 기본값: maximum-pool-size=10, minimum-idle=2
# 운영 환경 기본값: maximum-pool-size=30, minimum-idle=10
# HIKARI_MAXIMUM_POOL_SIZE=20
# HIKARI_MINIMUM_IDLE=5
# HIKARI_CONNECTION_TIMEOUT=30000
# HIKARI_IDLE_TIMEOUT=600000
# HIKARI_MAX_LIFETIME=1800000
# HIKARI_LEAK_DETECTION_THRESHOLD=60000

# =========================
# JPA 설정
# =========================
JPA_SHOW_SQL=false
JPA_DDL_AUTO=none
HIBERNATE_DIALECT=org.hibernate.dialect.MySQL8Dialect
HIBERNATE_BATCH_SIZE=50

# =========================
# Redis 설정
# =========================
REDIS_HOST=localhost
REDIS_PORT=6379

# Redis 연결 풀 설정 (선택적 - 환경별 파일에서 기본값 제공)
# 개발 환경 기본값: max-active=10, max-idle=5, min-idle=2
# 운영 환경 기본값: max-active=30, max-idle=15, min-idle=10
# REDIS_TIMEOUT=3000ms
# REDIS_POOL_MAX_ACTIVE=20
# REDIS_POOL_MAX_IDLE=10
# REDIS_POOL_MIN_IDLE=5
# REDIS_POOL_MAX_WAIT=2000ms

# Redis Health Check 설정 (선택적)
REDIS_HEALTH_CHECK_ENABLED=true
REDIS_HEALTH_CHECK_INTERVAL_MS=5000
REDIS_HEALTH_CHECK_MAX_CONSECUTIVE_FAILURES=3

# =========================
# RabbitMQ 설정
# =========================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_PREFETCH=10

# RabbitMQ 연결 풀 설정 (선택적 - 환경별 파일에서 기본값 제공)
# 개발 환경 기본값: connection-size=5, channel-size=10
# 운영 환경 기본값: connection-size=20, channel-size=50
# RABBITMQ_CONNECTION_TIMEOUT=5000
# RABBITMQ_PUBLISHER_CONFIRM_TYPE=correlated
# RABBITMQ_PUBLISHER_RETURNS=true
# RABBITMQ_TEMPLATE_MANDATORY=true
# RABBITMQ_CACHE_CONNECTION_SIZE=10
# RABBITMQ_CACHE_CHANNEL_SIZE=25

# =========================
# JWT 설정 (필수)
# =========================
JWT_SECRET=your-jwt-secret-key-here-minimum-256-bits
JWT_ACCESS_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000
JWT_REFRESH_ROTATION_THRESHOLD_DAYS=1

# =========================
# OAuth2 설정 (필수)
# =========================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret

OAUTH2_FAILURE_REDIRECT_URL=http://localhost:5173/auth/oauth/failure
OAUTH2_SALT=your-oauth2-salt-here
OAUTH2_STATE_VALIDITY_MINUTES=10
OAUTH2_REDIRECT_FRONT_URL=http://localhost:5173/auth/oauth/success

# =========================
# 인증 설정
# =========================
AUTH_COOKIE_SECURE=true

# =========================
# 비밀번호 정책 (선택적 - 기본값 제공)
# =========================
# PASSWORD_MIN_LENGTH=10
# PASSWORD_MAX_LENGTH=100
# PASSWORD_REQUIRE_UPPER_CASE=true
# PASSWORD_REQUIRE_LOWER_CASE=true
# PASSWORD_REQUIRE_DIGIT=true
# PASSWORD_REQUIRE_SPECIAL_CHAR=true
# PASSWORD_SPECIAL_CHARS=!@#$%^&*()_+-=[]{}|;:,.<>?

# =========================
# CORS 설정 (필수)
# =========================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# =========================
# AI 설정
# =========================
SPRING_AI_OPENAI_API_KEY=your-openai-api-key-here
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_GEMINI_MODEL=gemini-pro
GOOGLE_GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GOOGLE_GEMINI_TIMEOUT_SECONDS=30

KAKAO_API_KEY=your_kakao_api_key
KAKAO_SECRET=your_kakao_secret
TOSS_API_KEY=your_toss_api_key
TOSS_SECRET=your_toss_secret
STRIPE_API_KEY=your_stripe_api_key
STRIPE_SECRET=your_stripe_secret
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYMENT_WEBHOOK_SECRET=your_webhook_secret
# 환율 API
EXCHANGE_RATE_API_KEY=your_exchange_rate_api_key
EXCHANGE_RATE_API_URL=https://api.exchangerate-api.com/v4/latest/
PAYMENT_EXCHANGE_RATE_SCHEDULE=0 0 2 * * ?

# =========================
# Rate Limit 설정 (선택적 - 기본값 제공)
# =========================
# RATE_LIMIT_LOGIN=5
# RATE_LIMIT_SIGNUP=3
# RATE_LIMIT_PROMPT_CREATE=10
# RATE_LIMIT_GENERAL=100
# RATE_LIMIT_WINDOW_SECONDS=60
# RATE_LIMIT_LOG_CLEANUP_ENABLED=true
# RATE_LIMIT_LOG_CLEANUP_RETENTION_DAYS=90
# RATE_LIMIT_FAILURE_POLICY_FAIL_OPEN=true
# RATE_LIMIT_FAILURE_POLICY_LOG_FAILURE=true

# =========================
# 알림 설정 (선택적 - 기본값 제공)
# =========================
# NOTIFICATION_SSE_TIMEOUT=1800000
# NOTIFICATION_SSE_CLEANUP_INTERVAL=300000
# NOTIFICATION_DUPLICATE_CHECK_WINDOW=5
# NOTIFICATION_CLEANUP_ENABLED=true
# NOTIFICATION_RETENTION_DAYS=90
# NOTIFICATION_CLEANUP_SCHEDULE=0 0 2 * * ?
# NOTIFICATION_UNREAD_COUNT_TTL=60

# =========================
# 통계 설정 (선택적 - 기본값 제공)
# =========================
# STATISTICS_CACHE_TTL=300

# =========================
# 애플리케이션 설정 (선택적 - 기본값 제공)
# =========================
# APP_REDIS_HOT_TTL_SECONDS=86400

# =========================
# 로깅 설정 (선택적 - 기본값 제공)
# =========================
# LOG_LEVEL_ROOT=INFO